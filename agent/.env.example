# Copy to secrets/.env or /etc/starkhire-agent/agent.env and chmod 600.
# Never commit the real file. Never put keys in the frontend.

# Refuse to start unless this is sepolia (this prototype does not run on mainnet).
STARKNET_NETWORK=sepolia
# Public Sepolia RPC; replace with your own endpoint if you prefer.
STARKNET_RPC_URL=https://starknet-sepolia.public.blastapi.io

# Set after the StarkHire contract is deployed to Starknet Sepolia.
STARKHIRE_CONTRACT_ADDRESS=

# Starknet account that the contract stores as the authorized agent.
# The user creates this account in a wallet (Argent/Braavos or a signer they control).
AGENT_ACCOUNT_ADDRESS=
# Private key for AGENT_ACCOUNT_ADDRESS only. Never the owner's mainnet key.
AGENT_PRIVATE_KEY=

# HTTP API
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8797
# Exact HTTPS origin of the static frontend (no path). CORS and /api/notify allow only this origin.
# GitHub Pages origin is the host, not the /starkhire/ path.
FRONTEND_ORIGIN=https://drmessi007-ui.github.io

POLL_INTERVAL_MS=30000

# Optional LLM providers (same off-chain pipeline derived from OrbitHire).
# Empty keys = deterministic classifier and template reports.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
NEARAI_TIMEOUT_MS=20000
NEARAI_MAX_TOKENS=500
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_TOKENS=500
